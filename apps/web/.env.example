# ==============================================================================
# Tradedia Web + Express BFF Environment Configuration
# ==============================================================================

NODE_ENV="development"
PORT="3000"

# Public URL & CORS Allowed Origins (comma-separated in production)
APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"

# Local JSON fallback path (used ONLY when FIREBASE_SERVICE_ACCOUNT_* is unset)
# TRADEDIA_STORAGE_PATH=".data/tradedia-store.json"

# Session JWT signing secret (REQUIRED in production, min 16 characters; use 32+ random hex)
AUTH_SESSION_SECRET=""

# Python Screener Backend URL & Shared HMAC Secret
# Local dev: http://127.0.0.1:8000/api/v1
# Railway Private Network: http://${{tradedia-analytics.RAILWAY_PRIVATE_DOMAIN}}:8000/api/v1
SCREENER_BACKEND_URL="http://127.0.0.1:8000/api/v1"
SERVICE_AUTH_SECRET=""

# Market Data Provider Configuration (Server-Side Only — NEVER use VITE_* for tokens!)
MARKET_DATA_PROVIDER="upstox"
# Required in production (NODE_ENV=production) to authorize each market-data use case:
# AUTHORIZE_ANALYTICS_PROVIDER="true"
# AUTHORIZE_PAPER_TRADING_PROVIDER="true"
# AUTHORIZE_HISTORICAL_REPLAY_PROVIDER="true"

# Upstox Read-Only Analytics Token (1-year read-only token from Upstox Developer Console -> Analytics tab)
UPSTOX_ANALYTICS_TOKEN=""
UPSTOX_RATE_LIMIT_PER_SECOND="10"
# Split your shared Upstox 500/min quota between Node (e.g. 100) and Python (e.g. 300)
UPSTOX_RATE_LIMIT_PER_MINUTE="100"
UPSTOX_TIMEOUT_MS="8000"

# Commercial & Paper-Trading Rights Attestation (do NOT set true unless licensed for permitted use)
UPSTOX_COMMERCIAL_REDISTRIBUTION_AUTHORIZED="false"
UPSTOX_PAPER_TRADING_AUTHORIZED="false"

# Firebase Auth & Firestore Server Persistence (REQUIRED in Railway to persist users, ledgers & subscriptions in Firestore without a Volume)
# Generate from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID="tradedia-b6cb0"
FIREBASE_SERVICE_ACCOUNT_CLIENT_EMAIL=""
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Optional Vite build-time Firebase overrides (defaults to firebase-applet-config.json when unset)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Note: Firebase Analytics is not initialized; GA4 is configured via VITE_GA_MEASUREMENT_ID below
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Google Analytics 4 & Google Ads Conversion Tracking (Vite build-time variables — enabled ONLY in production builds after user consent)
# Set in Railway production for tradedia-web; leave empty in local dev & staging
VITE_GA_MEASUREMENT_ID=""
VITE_GOOGLE_ADS_ID=""
VITE_GOOGLE_ADS_SIGNUP_LABEL=""

# Email OTP Delivery (Resend API — verify your domain before setting OTP_FROM_EMAIL in production)
RESEND_API_KEY=""
OTP_FROM_EMAIL="Tradedia <onboarding@resend.dev>"

# Razorpay Payment Gateway (use rzp_live_* in production, or set ALLOW_RAZORPAY_TEST_IN_PROD=true for staging)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ==============================================================================
# Tradedia Python FastAPI Screener & Backtesting Backend Environment Configuration
# ==============================================================================

# Use "staging" for private testing or "production" once commercial Upstox rights are confirmed
ENVIRONMENT=development
PORT=8000

# Market Data Provider
MARKET_DATA_PROVIDER=upstox
PRICE_ADJUSTMENT_POLICY=SPLIT_ADJUSTED_ONLY
ALLOW_DELAYED_DATA=true
ALLOW_STALE_CACHE_FALLBACK=true
REQUIRE_PRODUCTION_APPROVED_PROVIDER=false
PROVIDER_PRODUCTION_APPROVED_OVERRIDE=true
PROVIDER_IS_REALTIME_OVERRIDE=true
PROVIDER_ESTIMATED_DELAY_MINUTES=0

# Upstox Read-Only Analytics Token (shared account quota: reserve ~300/min for Python, ~100/min for Node)
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_TIMEOUT_SECONDS=10.0
UPSTOX_MAX_CONCURRENCY=12
UPSTOX_RATE_LIMIT_PER_MINUTE=300
UPSTOX_COMMERCIAL_REDISTRIBUTION_APPROVED=false

# Scanner & Background Scheduler
SCANNER_MAX_WORKERS=12
SWING_SCANNER_DEFAULT_UNIVERSE_LIMIT=500
INTRADAY_SCANNER_DEFAULT_UNIVERSE_LIMIT=100
SWING_SCANNER_DEFAULT_RESULT_LIMIT=500
INTRADAY_SCANNER_DEFAULT_RESULT_LIMIT=60
INTRADAY_REFRESH_SECONDS=300
ENABLE_BACKGROUND_SCHEDULER=true

# Persistent Cache Directory (mount a Railway Volume at /data/cache and set CACHE_DIR=/data/cache)
# CACHE_DIR=/data/cache
DAILY_DATA_TTL_SECONDS=14400
INTRADAY_DATA_TTL_SECONDS=240
RATE_LIMIT_REQUESTS_PER_SECOND=25

# Walk-Forward Backtesting & Governance
WALK_FORWARD_DEFAULT_FOLDS=4
WALK_FORWARD_MODE=EXPANDING
ENABLE_PUBLIC_STOCK_SIGNALS=true
SIGNAL_CLASSIFICATION_MODE=FULL
ENABLE_LEGACY_FIELD_ALIASES=true

# Service-to-Service Auth (set AUTH_MODE=service_token + matching SERVICE_AUTH_SECRET in Railway)
AUTH_MODE=disabled_dev_only
SERVICE_AUTH_SECRET=
FIREBASE_PROJECT_ID=tradedia-b6cb0

# Server & CORS (only needed if exposed directly; keep Railway service private behind tradedia-web)
BACKEND_HOST=::
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

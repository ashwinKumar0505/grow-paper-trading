# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Market Data Provider Configuration (Server-Side Only — NEVER use VITE_* for tokens!)
# Active provider: "upstox" (default in development). Explicit rollback option: "yahoo_finance".
MARKET_DATA_PROVIDER="upstox"
# Optional per-use-case overrides:
# MARKET_DATA_PROVIDER_ANALYTICS="upstox"
# MARKET_DATA_PROVIDER_PAPER_TRADING="upstox"
# MARKET_DATA_PROVIDER_REPLAY="upstox"

# Upstox Read-Only Analytics Token (1-year read-only token from Upstox Developer Console -> Analytics tab)
# Required when MARKET_DATA_PROVIDER="upstox". Never commit or expose to client bundles.
UPSTOX_ANALYTICS_TOKEN=""
UPSTOX_RATE_LIMIT_PER_SECOND="10"
UPSTOX_RATE_LIMIT_PER_MINUTE="120"
UPSTOX_TIMEOUT_MS="8000"

# Commercial & Paper-Trading Rights Attestation (do NOT set true unless licensed for permitted use)
UPSTOX_COMMERCIAL_REDISTRIBUTION_AUTHORIZED="false"
UPSTOX_PAPER_TRADING_AUTHORIZED="false"

# Python Screener Backend URL & Service Auth Secret
SCREENER_BACKEND_URL="http://127.0.0.1:8000/api/v1"
SERVICE_AUTH_SECRET=""

# Firebase Web App Config (overrides firebase-applet-config.json when set)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
# Leave empty to use the (default) Firestore database in your new Firebase project
VITE_FIREBASE_DATABASE_ID=""

# Email OTP Delivery (optional: Resend API for real inbox delivery; falls back to dev preview if unset)
RESEND_API_KEY=""
OTP_FROM_EMAIL="Tradedia <onboarding@resend.dev>"

# Razorpay Payment Gateway (Test or Live credentials; falls back to demo mode if unset)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

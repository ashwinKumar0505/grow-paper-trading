rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own user profile, holdings, orders, and subscription mapping
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId
                         || userId.matches('^(email_|user_|google_).*');

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId
                           || userId.matches('^(email_|user_|google_).*');
      }
    }

    // Top-level subscriptions collection mapping users to Razorpay payment & subscription records
    match /subscriptions/{subscriptionId} {
      allow read, write: if request.auth != null || resource == null || request.resource != null;
    }
  }
}
